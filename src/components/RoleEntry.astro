---
import type { Role } from '../data/site';

interface Props {
  role: Role;
}
const { role } = Astro.props;
---
<li class="role">
  <div class="role__head">
    <h3 class="role__title">
      {role.title}<span class="role__org">{role.org}</span>
    </h3>
    <span class="role__period">{role.period}</span>
  </div>
  <p class="role__place">{role.place}</p>
  <ul class="role__points">
    {role.points.map((point) => <li>{point}</li>)}
  </ul>
</li>
