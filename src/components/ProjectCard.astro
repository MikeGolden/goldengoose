---
import Icon from './Icon.astro';
import type { ProjectLink } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  project: ProjectLink;
}
const { project } = Astro.props;
const external = project.href.startsWith('http');
const href = external ? project.href : withBase(project.href);
---
<a
  class="card"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <div class="card__media">
    <img class="card__thumb" src={withBase(project.image)} alt={project.imageAlt} loading="lazy" decoding="async" width="1280" height="800" />
  </div>
  <div class="card__body">
    <span class="card__year">{project.year}</span>
    <h3 class="card__title">{project.title}<Icon name="arrow" /></h3>
    <p class="card__desc">{project.description}</p>
  </div>
</a>
