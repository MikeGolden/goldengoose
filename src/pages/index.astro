---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LinkCard from '../components/LinkCard.astro';
import RoleEntry from '../components/RoleEntry.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { withBase } from '../lib/paths';

const cv = site.links.find((l) => l.icon === 'file');
const [first, ...rest] = site.name.split(' ');
const [lede, ...about] = site.about;
---
<Base>
  <section class="hero">
    <div class="shell">
      <div class="hero__top">
        <img class="hero__avatar" src={withBase(site.avatar)} alt={site.name} width="56" height="56" />
        <div class="hero__meta">
          {site.availability && (
            <span><i class="dot" aria-hidden="true"></i>{site.availability}</span>
          )}
          <span>{site.location}</span>
        </div>
      </div>

      <h1>
        <span class="line"><span>{first}</span></span>{' '}
        <span class="line"><span>{rest.join(' ')}</span></span>
      </h1>

      <div class="hero__bottom">
        <p class="hero__role"><strong>{site.role}.</strong> <em>{site.tagline}</em></p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>
            <Icon name="mail" />Get in touch
          </a>
          {cv && (
            <a class="btn" href={cv.href.startsWith('http') ? cv.href : withBase(cv.href)}>
              <Icon name="download" />Download CV
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <Section id="about" label="About">
    <div class="prose">
      <p class="prose__lede">{lede}</p>
      {about.map((p) => <p>{p}</p>)}
    </div>
  </Section>

  <Section id="experience" label="Experience">
    <ol class="timeline">
      {site.experience.map((role) => <RoleEntry role={role} />)}
    </ol>
    <p class="education">{site.education}</p>
  </Section>

  <Section id="stack" label="Stack">
    <dl class="stack-grid">
      {site.stack.map((row) => (
        <div class="stack-row">
          <dt class="stack-row__key">{row.key}</dt>
          <dd class="tags">
            {row.items.map((item) => <span class="tag">{item}</span>)}
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="work" label="Selected work">
    <div class="projects">
      {site.projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>

  <Section id="links" label="Contact">
    <div class="links">
      {site.links.map((link) => <LinkCard link={link} />)}
    </div>
  </Section>
</Base>
