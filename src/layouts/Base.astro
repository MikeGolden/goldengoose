---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { site } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}
const { title = `${site.name} — ${site.role}`, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: site.url,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  sameAs: site.links.filter((l) => l.href.startsWith('http')).map((l) => l.href),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0c0a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <header class="topbar" id="topbar">
      <div class="shell topbar__inner">
        <a class="topbar__mark" href="#top" aria-label={`${site.name}, back to top`}>{site.initials}</a>
        <nav class="topbar__nav" aria-label="Sections">
          {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <span class="topbar__clock" data-clock={site.timezone}></span>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer>
      <div class="shell footer__inner">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>{site.location}</span>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>

    <script is:inline>
      const bar = document.getElementById('topbar');
      const onScroll = () => bar.dataset.scrolled = String(window.scrollY > 8);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });

      const clocks = document.querySelectorAll('[data-clock]');
      const tick = () => clocks.forEach((el) => {
        el.textContent = new Intl.DateTimeFormat('en-GB', {
          hour: '2-digit', minute: '2-digit', timeZone: el.dataset.clock,
        }).format(new Date()) + ' local';
      });
      tick();
      setInterval(tick, 15000);
    </script>
  </body>
</html>
