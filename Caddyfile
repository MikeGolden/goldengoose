{
	# Let's Encrypt account address. Required for a real domain; ignored for :80.
	email {$ACME_EMAIL:admin@example.com}
	admin off
}

# SITE_ADDRESS=":80"            → plain HTTP, no certs (local, CI, behind another proxy)
# SITE_ADDRESS="example.com"    → automatic HTTPS: ACME cert, HTTP→HTTPS redirect, renewal
{$SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		# script-src needs 'unsafe-inline' for the JSON-LD block and the 4-line
		# scroll handler; style-src stays strict — no inline style attributes.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
	}

	# hashed filenames — cache forever
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# html — always revalidate so a deploy is visible immediately
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	file_server

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server {
			status {err.status_code}
		}
	}
}
